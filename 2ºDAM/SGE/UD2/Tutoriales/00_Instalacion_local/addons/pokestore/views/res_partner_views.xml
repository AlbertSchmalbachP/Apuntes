<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pokestore_res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.pokestore</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="PokeStore" name="pokestore">
                    <group string="PokeStore">
                        <field name="collector_code"/>
                        <field name="favorite_pokemon"/>
                        <field name="collector_level"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
