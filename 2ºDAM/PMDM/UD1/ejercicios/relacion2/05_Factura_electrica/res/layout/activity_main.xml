<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_app">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Factura eléctrica simplificada" style="@style/TituloPantalla" />
        <EditText android:id="@+id/etKwh" style="@style/CampoFormulario"
            android:hint="Consumo en kWh" android:inputType="numberDecimal|numberSigned" />
        <EditText android:id="@+id/etDias" style="@style/CampoFormulario"
            android:hint="Días facturados (1-31)" android:inputType="numberSigned" />
        <CheckBox android:id="@+id/cbBonoSocial"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aplicar bono social" />
        <Button android:id="@+id/btnCalcular" style="@style/BotonPrincipal" android:text="Calcular factura" />
        <Button android:id="@+id/btnLimpiar" style="@style/BotonSecundario" android:text="Limpiar" />
        <TextView android:id="@+id/tvResultado" style="@style/TextoResultado"
            android:text="Introduce consumo y días." />
    </LinearLayout>
</ScrollView>
